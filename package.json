{
  "name": "Territory-Map-Maker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @segment/api",
    "dev:web": "npm run dev --workspace @segment/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace @segment/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migration:generate": "npm run migration:generate --workspace @segment/api",
    "migration:run": "npm run migration:run --workspace @segment/api",
    "migration:revert": "npm run migration:revert --workspace @segment/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
